{
  "name": "cimax-platform",
  "version": "1.0.0",
  "description": "Sanitized operations platform for dental order and doctor management.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "start": "node dist/index.js",
    "build": "npm run build:server",
    "build:server": "swc src --out-dir dist",
    "build:client": "npm --prefix client run build",
    "dev": "nodemon --watch \"dist/**/*\" -e js ./dist/index.js",
    "dev:build": "swc src -w --out-dir dist",
    "start:client": "npm --prefix client start",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:contract": "npm run build && node --test tests/openapi-contract.test.cjs",
    "verify": "npm test && npm run build:client",
    "lint": "node -e \"console.log('No backend lint configured yet')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^6.0.0",
    "mongoose": "^6.13.9",
    "morgan": "^1.10.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "nodemon": "^3.1.14"
  }
}
